              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Picture type is PNG" enabled="true">
              <stringProp name="JSON_PATH">$.data.fileType</stringProp>
              <stringProp name="EXPECTED_VALUE">image/png</stringProp>
              <boolProp name="JSONVALIDATION">true</boolProp>
