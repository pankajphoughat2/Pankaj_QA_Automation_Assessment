            <hashTree/>
            <UserParameters guiclass="UserParametersGui" testclass="UserParameters" testname="Generate unique Employee ID" enabled="true">
              <collectionProp name="UserParameters.names">
                <stringProp name="n0">employeeId</stringProp>
              </collectionProp>
              <collectionProp name="UserParameters.thread_values">
                <collectionProp name="1091835859">
                  <stringProp name="v0">${empIdPrefix}${__RandomString(8,0123456789,)}</stringProp>
                </collectionProp>
              </collectionProp>
              <boolProp name="UserParameters.per_iteration">true</boolProp>
            </UserParameters>
